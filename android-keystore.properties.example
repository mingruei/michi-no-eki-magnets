# Copy to android/keystore.properties and fill in values from:
#   eas credentials -p android  →  production  →  Keystore  →  Download
#
# storeFile supports:
#   ~/upload-keystore.jks     (home directory — recommended)
#   /absolute/path/to.jks
#   relative/path.jks         (resolved from android/)
#
# Verify SHA-1 matches Google Play upload key:
#   keytool -list -v -keystore ~/upload-keystore.jks -alias YOUR_ALIAS
# Expected: 3B:90:D1:8A:0A:1C:F2:B7:64:AE:B4:47:86:8D:0C:FF:FD:66:70:B6

storeFile=~/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD

# Place the .jks in your home directory:
#   /Users/<you>/upload-keystore.jks
# Do NOT use android/app/~/… — Gradle would treat that ~ as a folder name.
