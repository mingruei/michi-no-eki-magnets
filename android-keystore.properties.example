# Generated/copied to android/keystore.properties for local Play .aab builds.
#
# Prefer the setup script (expands to an absolute path — required by Gradle):
#   ./scripts/setup-android-release-keystore.sh
#
# That writes something like:
#   storeFile=/Users/you/upload-keystore.jks
#
# Do NOT rely on storeFile=~/upload-keystore.jks in hand-edited files.
# Gradle resolves "~" under android/app/ and breaks signing validation.
#
# Verify SHA-1 matches Google Play upload key:
#   keytool -list -v -keystore ~/upload-keystore.jks -alias YOUR_ALIAS
# Expected: 3B:90:D1:8A:0A:1C:F2:B7:64:AE:B4:47:86:8D:0C:FF:FD:66:70:B6

storeFile=/REPLACE_WITH_ABSOLUTE_PATH/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
